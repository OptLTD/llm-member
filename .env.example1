# 产品 A 部署示例 — 复制为 .env 后修改

APP_NAME=ProductA
# 首次启动写入 DB 的默认模块（之后在后台「系统设置」开关）
# APP_MODULES=member,device,analytics,coupon,referral,survey,feedback
APP_MODULES=member,device,analytics,coupon,referral,survey,feedback
# 去掉 llm-relay 模块时不配置 LLM_*

DB_DRIVER=sqlite
# 生产: DB_DRIVER=postgres
# POSTGRES_DSN=postgres://...

AUTH_CALLBACK=myapp-a://auth-callback

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 启用 llm-relay 时取消注释：
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_DEFAULT_MODEL=gpt-4o-mini
