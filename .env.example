# [WEB SERVER]
APP_PORT=8080
APP_MODE=debug
APP_NAME=Demo
DATA_PATH=./data
# 回调签名密钥（必填，用于 /v1/build-token 与 verify-token）
APP_SECRET=change-me-to-a-long-random-secret
# CORS 允许来源，逗号分隔；使用 * 时不允许带 credentials
CORS_ORIGINS=http://localhost:8080
# 是否将完整 messages/response 写入 llm_log（默认 false）
LOG_STORE_BODY=false

# 认证回调配置
AUTH_CALLBACK=https://your-app.com/auth-callback

# [DATABASE]
# DB_DRIVER: sqlite | postgres | d1（默认 sqlite）
DB_DRIVER=sqlite
# 首次启动时写入数据库的默认模块；之后请在管理后台「系统设置」中开关
# APP_MODULES=member,device,analytics,coupon,referral,survey,feedback,llm-relay

# D1（DB_DRIVER=d1 时）
# D1_ACCOUNT_ID=
# D1_DATABASE_ID=
# D1_API_TOKEN=
# D1_PROXY_ENDPOINT=
# D1_PROXY_TOKEN=

# PostgreSQL数据库配置（DB_DRIVER=postgres 时）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_postgres_username
POSTGRES_PASS=your_postgres_password
POSTGRES_NAME=your_database_name
# 也可直接使用完整 DSN / DATABASE_URL
# POSTGRES_DSN=host=localhost user=postgres password=xxx dbname=demo port=5432 sslmode=disable
# DATABASE_URL=postgres://postgres:xxx@localhost:5432/demo?sslmode=disable

# Redis配置（可选；用于登录 token 与配额原子预扣）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0

# Mock 支付回调（仅 APP_MODE=debug|test 可用）
MOCK_WEBHOOK_SECRET=dev-mock-secret

# [BASE SERVICE]
# 邮件配置
MAIL_FROM_NAME=MEMBER-PROXY
MAIL_FROM_ADDR=xxxxxxxx@163.com
MAIL_HOST_ADDR=smtp.163.com:994
MAIL_PASS_WORD=xxxxxxxxxxxxxxxx
MAIL_USER_NAME=xxxxxxxx@163.com

# 管理员配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# [LLM RELAY] 单一 OpenAI-compatible 上游
# 启用 llm-relay 模块时需要配置（可在系统设置中开关该模块）
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_DEFAULT_MODEL=gpt-4o-mini
# 可选：对外暴露的模型列表（逗号分隔）；不填则仅暴露 DEFAULT
# LLM_MODELS=gpt-4o-mini,gpt-4o


# [PAYMENT]
# 支付宝配置
ALIPAY_APP_ID=your_alipay_app_id_here
ALIPAY_TOKEN=your_alipay_token_here

# 微信支付配置
WECHAT_APP_ID=your_wechat_app_id_here
WECHAT_TOKEN=your_wechat_token_here
# 微信支付v3专用配置
WECHAT_MCH_ID=your_wechat_mch_id_here
WECHAT_SERIAL_NO=your_wechat_serial_no_here
WECHAT_APIV3_KEY=your_wechat_apiv3_key_here
WECHAT_PRIVATE_KEY=your_wechat_private_key_here
WECHAT_NOTIFY_URL=http://localhost:8080/api/payment/wechat/notify

# Stripe 配置
STRIPE_PUBLIC_KEY=your_stripe_public_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WH_SECRET=your_stripe_webhook_secret_here

# Creem 配置
CREEM_API_KEY=your_creem_api_key_here
CREEM_WH_SECRET=your_creem_webhook_secret_here


# Stripe 需按 Plan 配置对应 Price ID
# Creem 需按 Plan 配置对应 Product ID
PLAN_BASIC_ID=price_1Q1234567890123456789012
PLAN_EXTRA_ID=price_1Q1234567890123456789013
PLAN_ULTRA_ID=price_1Q1234567890123456789014
PLAN_SUPER_ID=price_1Q1234567890123456789015
